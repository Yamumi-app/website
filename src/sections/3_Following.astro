---
import FeatureSection from "../components/FeatureSection.astro";
---

<FeatureSection
    id="overview"
    titleId="music-title"
    title="Музыка там, где вы"
    description="Плеер отображается поверх всех окон и остаётся на своём месте
    даже после смены рабочей области.
    Не нужно искать окно, чтобы поставить лайк."
>
    <video
        class="video honey"
        data-spin="true"
        data-spin-color="#fff"
        data-expose="true"
        playsinline
        loop
        muted
        aria-label="Демонстрация: плеер Yamumi отображается поверх всех окон"
    >
        <source src="/following.webm" type="video/webm" />
        <source src="/following.mp4" type="video/mp4" />
    </video>

    <script>
        const video = document.querySelector<HTMLVideoElement>(".video")!;
        setInterval(() => {
            if (video.paused) {
                video.play();
            }
        }, 1000);
    </script>
</FeatureSection>

<style>
    .video {
        border-radius: 12px;
        width: 100%;
        aspect-ratio: 16 / 9;
    }
</style>
